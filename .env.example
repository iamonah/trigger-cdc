# Copy this file to .env and adjust if needed:
#   cp .env.example .env
DATABASE_URL=postgres://cdc:cdc@localhost:5433/cdc?sslmode=disable

# LISTEN/NOTIFY channel used by the trigger and cmd/listener.
CDC_CHANNEL=users_changes

# Logical replication objects used by cmd/replicator.
CDC_PUBLICATION=users_publication
CDC_SLOT=users_slot
